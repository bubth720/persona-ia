<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET : uniquement téléchargement initial des modèles (révisions figées, SHA-256) et mode PC optionnel. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application
        android:label="PERSONA IA"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">
        <activity android:name=".ui.MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.ReferencesActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />
        <activity android:name=".ui.GenerateActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />
        <activity android:name=".ui.ResultsActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.LocalGenerateActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />
        <activity android:name=".ui.ModelActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />
        <activity android:name=".ui.HistoryActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />
        <service android:name=".engine.GenerationService" android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Génération d'image locale sur le processeur (plusieurs minutes), lancée par l'utilisateur" />
        </service>
    </application>
</manifest>
